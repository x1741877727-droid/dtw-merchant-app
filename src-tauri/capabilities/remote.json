{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window-controls",
  "description": "允许远程商户后台页面(duitaofang.cn)调用窗口控制——自定义标题栏的拖动/最小化/关闭",
  "windows": ["main"],
  "remote": {
    "urls": ["https://duitaofang.cn", "https://*.duitaofang.cn"]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
